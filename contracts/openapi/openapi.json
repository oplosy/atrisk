{
  "openapi": "3.1.0",
  "info": {
    "title": "AtlasRisk HTTP API",
    "version": "1.0.0",
    "description": "Contract-first foundation for the AtlasRisk decision-support API."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/v1/series": {
      "get": {
        "operationId": "listSeries",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Stable series page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SeriesPage" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" } }
      }
    },
    "/api/v1/series/{series_id}": {
      "get": {
        "operationId": "getSeries",
        "parameters": [{ "$ref": "#/components/parameters/SeriesId" }],
        "responses": { "200": { "description": "Series metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Series" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/series/{series_id}/observations": {
      "get": {
        "operationId": "listObservations",
        "parameters": [{ "$ref": "#/components/parameters/SeriesId" }, { "$ref": "#/components/parameters/ObservationMode" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "$ref": "#/components/parameters/AsOf" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Point-in-time observation page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObservationPage" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/SourceAsOfUnsupported" } }
      }
    },
    "/api/v1/series/{series_id}/revisions": {
      "get": {
        "operationId": "listObservationRevisions",
        "parameters": [{ "$ref": "#/components/parameters/SeriesId" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Append-only revision page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObservationPage" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/timeline": {
      "get": {
        "operationId": "listCrossSourceTimeline",
        "parameters": [{ "name": "series_id", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1 } }, { "$ref": "#/components/parameters/Mode" }, { "$ref": "#/components/parameters/From" }, { "$ref": "#/components/parameters/To" }, { "$ref": "#/components/parameters/AsOf" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }],
        "responses": { "200": { "description": "Cross-source timeline page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ObservationPage" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/SourceAsOfUnsupported" } }
      }
    },
    "/api/v1/quality/evaluate": {
      "post": {
        "operationId": "evaluateDataQuality",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QualityEvaluationRequest" } } } },
        "responses": { "200": { "description": "Deterministic data-quality evaluation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QualityEvaluation" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/instruments": {
      "get": { "operationId": "listInstruments", "responses": { "200": { "description": "Stable instrument identities", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InstrumentPage" } } } } } },
      "post": { "operationId": "createInstrument", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateInstrumentRequest" } } } }, "responses": { "201": { "description": "Created instrument", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Instrument" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/instruments/{instrument_id}": {
      "get": { "operationId": "getInstrument", "parameters": [{ "$ref": "#/components/parameters/InstrumentId" }], "responses": { "200": { "description": "Instrument identity", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Instrument" } } } }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/v1/instruments/{instrument_id}/status": {
      "patch": { "operationId": "updateInstrumentStatus", "parameters": [{ "$ref": "#/components/parameters/InstrumentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InstrumentStatusRequest" } } } }, "responses": { "200": { "description": "Updated lifecycle status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Instrument" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/v1/portfolios": {
      "get": { "operationId": "listPortfolios", "responses": { "200": { "description": "Portfolios", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortfolioPage" } } } } } },
      "post": { "operationId": "createPortfolio", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortfolioRequest" } } } }, "responses": { "201": { "description": "Created portfolio", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Portfolio" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" } } }
    },
    "/api/v1/portfolios/{portfolio_id}": {
      "get": { "operationId": "getPortfolio", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "responses": { "200": { "description": "Portfolio", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Portfolio" } } } }, "404": { "$ref": "#/components/responses/NotFound" } } },
      "patch": { "operationId": "updatePortfolio", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortfolioRequest" } } } }, "responses": { "200": { "description": "Updated portfolio", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Portfolio" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" } } },
      "delete": { "operationId": "deletePortfolio", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "responses": { "204": { "description": "Deleted before reference" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/portfolios/{portfolio_id}/accounts": {
      "get": { "operationId": "listAccounts", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "responses": { "200": { "description": "Portfolio accounts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountPage" } } } } } },
      "post": { "operationId": "createAccount", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountRequest" } } } }, "responses": { "201": { "description": "Created account", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/v1/accounts/{account_id}": {
      "get": { "operationId": "getAccount", "parameters": [{ "$ref": "#/components/parameters/AccountId" }], "responses": { "200": { "description": "Account", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } } } },
      "patch": { "operationId": "updateAccount", "parameters": [{ "$ref": "#/components/parameters/AccountId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountRequest" } } } }, "responses": { "200": { "description": "Updated account", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } } } },
      "delete": { "operationId": "deleteAccount", "parameters": [{ "$ref": "#/components/parameters/AccountId" }], "responses": { "204": { "description": "Deleted before reference" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/portfolios/{portfolio_id}/snapshots": {
      "get": { "operationId": "listPortfolioSnapshots", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "responses": { "200": { "description": "Immutable portfolio snapshots", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SnapshotPage" } } } } } },
      "post": { "operationId": "createPortfolioSnapshot", "parameters": [{ "$ref": "#/components/parameters/PortfolioId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSnapshotRequest" } } } }, "responses": { "201": { "description": "Committed immutable snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } } }, "400": { "$ref": "#/components/responses/InvalidRequest" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/snapshots/{snapshot_id}": {
      "get": { "operationId": "getPortfolioSnapshot", "parameters": [{ "$ref": "#/components/parameters/SnapshotId" }], "responses": { "200": { "description": "Immutable snapshot with lines", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Snapshot" } } } }, "404": { "$ref": "#/components/responses/NotFound" } } }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": { "$ref": "../schemas/error-envelope.schema.json" },
      "PageMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit", "has_more"],
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "next_cursor": { "type": "string", "minLength": 1 },
          "has_more": { "type": "boolean" }
        }
      },
      "Problem": { "type": "object", "required": ["code", "message", "request_id"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "request_id": { "type": "string" }, "details": { "type": "object", "additionalProperties": true } } },
      "Series": { "type": "object", "required": ["id", "source_code", "name", "unit", "frequency", "capabilities"], "properties": { "id": { "type": "string", "format": "uuid" }, "dataset_id": { "type": "string", "format": "uuid" }, "source_code": { "type": "string" }, "source_name": { "type": "string" }, "dataset_external_key": { "type": "string" }, "name": { "type": "string" }, "unit": { "type": "string" }, "frequency": { "type": "string" }, "seasonal_adjustment": { "type": "string" }, "source_timezone": { "type": "string" }, "freshness_policy": { "type": "object", "additionalProperties": true }, "capabilities": { "$ref": "#/components/schemas/TimelineCapabilities" } } },
      "TimelineCapabilities": { "type": "object", "required": ["latest", "source_as_of", "system_as_of", "revisions"], "properties": { "latest": { "type": "boolean" }, "source_as_of": { "type": "boolean" }, "system_as_of": { "type": "boolean" }, "revisions": { "type": "boolean" } } },
      "Observation": { "type": "object", "required": ["id", "series_id", "observation_time", "unit", "frequency", "data_source_code", "clocks", "quality", "raw_provenance_id", "raw_object_sha256"], "properties": { "id": { "type": "string", "format": "uuid" }, "series_id": { "type": "string", "format": "uuid" }, "observation_time": { "type": "string", "format": "date-time" }, "value": { "type": "string" }, "value_text": { "type": "string" }, "unit": { "type": "string" }, "frequency": { "type": "string" }, "data_source_code": { "type": "string" }, "clocks": { "type": "object", "additionalProperties": true }, "quality": { "type": "object", "additionalProperties": true }, "raw_provenance_id": { "type": "string", "format": "uuid" }, "raw_object_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
      "QualityEvaluationInput": { "type": "object", "additionalProperties": false, "required": ["series_id", "required"], "properties": { "series_id": { "type": "string", "format": "uuid" }, "required": { "type": "boolean" } } },
      "QualityEvaluationRequest": { "type": "object", "additionalProperties": false, "required": ["from", "to", "as_of", "inputs"], "properties": { "from": { "type": "string", "format": "date-time", "description": "Inclusive start of the observation window." }, "to": { "type": "string", "format": "date-time", "description": "Exclusive end of the observation window; must not exceed as_of." }, "as_of": { "type": "string", "format": "date-time", "description": "UTC system-knowledge cutoff used to select immutable revisions." }, "inputs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/components/schemas/QualityEvaluationInput" } } } },
      "QualityReason": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "affected_dates": { "type": "array", "items": { "type": "string", "format": "date" } } } },
      "QualityInputResult": { "type": "object", "additionalProperties": false, "required": ["series_id", "required", "classification", "state", "evaluated_at", "reasons"], "properties": { "series_id": { "type": "string", "format": "uuid" }, "required": { "type": "boolean" }, "classification": { "type": "string", "enum": ["fresh", "stale", "missing", "partial", "suspect", "revised"] }, "state": { "type": "string", "enum": ["valid", "degraded", "blocked"] }, "policy_version": { "type": "string" }, "evaluated_at": { "type": "string", "format": "date-time" }, "reasons": { "type": "array", "items": { "$ref": "#/components/schemas/QualityReason" } } } },
      "QualityEvaluation": { "type": "object", "additionalProperties": false, "required": ["state", "evaluated_at", "items"], "properties": { "state": { "type": "string", "enum": ["valid", "degraded", "blocked"] }, "evaluated_at": { "type": "string", "format": "date-time" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/QualityInputResult" } } } },
      "Instrument": { "type": "object", "additionalProperties": false, "required": ["id", "canonical_symbol", "instrument_type", "native_unit", "external_ids", "status", "created_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "canonical_symbol": { "type": "string", "minLength": 1 }, "instrument_type": { "type": "string", "enum": ["cash", "currency", "spot_crypto", "manual_spot", "fixed_rate_bond"] }, "native_unit": { "type": "string", "pattern": "^[A-Z0-9]+$" }, "external_ids": { "type": "array", "items": { "$ref": "#/components/schemas/ExternalIdentifier" } }, "status": { "type": "string", "enum": ["active", "inactive", "delisted"] }, "created_at": { "type": "string", "format": "date-time" } } },
      "ExternalIdentifier": { "type": "object", "additionalProperties": false, "required": ["namespace", "external_id"], "properties": { "namespace": { "type": "string", "minLength": 1 }, "external_id": { "type": "string", "minLength": 1 } } },
      "CreateInstrumentRequest": { "type": "object", "additionalProperties": false, "required": ["canonical_symbol", "instrument_type", "native_unit"], "properties": { "canonical_symbol": { "type": "string", "minLength": 1 }, "instrument_type": { "type": "string", "enum": ["cash", "currency", "spot_crypto", "manual_spot", "fixed_rate_bond"] }, "native_unit": { "type": "string", "pattern": "^[A-Za-z0-9]+$", "description": "Normalized to uppercase before persistence." }, "external_ids": { "type": "array", "items": { "$ref": "#/components/schemas/ExternalIdentifier" } }, "status": { "type": "string", "enum": ["active", "inactive", "delisted"], "default": "active" } } },
      "InstrumentStatusRequest": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "type": "string", "enum": ["active", "inactive", "delisted"] } } },
      "InstrumentPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Instrument" } } } },
      "Portfolio": { "type": "object", "additionalProperties": false, "required": ["id", "name", "reporting_currency", "metadata", "created_at", "updated_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string", "minLength": 1 }, "reporting_currency": { "type": "string", "enum": ["TRY", "USD"] }, "metadata": { "type": "object", "additionalProperties": true }, "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "PortfolioRequest": { "type": "object", "additionalProperties": false, "required": ["name", "reporting_currency"], "properties": { "name": { "type": "string", "minLength": 1 }, "reporting_currency": { "type": "string", "enum": ["TRY", "USD"] }, "metadata": { "type": "object", "additionalProperties": true } } },
      "PortfolioPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Portfolio" } } } },
      "Account": { "type": "object", "additionalProperties": false, "required": ["id", "portfolio_id", "name", "metadata", "created_at", "updated_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "portfolio_id": { "type": "string", "format": "uuid" }, "name": { "type": "string", "minLength": 1 }, "metadata": { "type": "object", "additionalProperties": true }, "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "AccountRequest": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "metadata": { "type": "object", "additionalProperties": true } } },
      "AccountPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } } } },
      "SnapshotLineInput": { "type": "object", "additionalProperties": false, "required": ["account_id", "instrument_id", "quantity"], "properties": { "account_id": { "type": "string", "format": "uuid" }, "instrument_id": { "type": "string", "format": "uuid" }, "quantity": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }, "total_cost_basis": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }, "modified_duration_years": { "type": "string" }, "convexity_years_squared": { "type": "string" } } },
      "CreateSnapshotRequest": { "type": "object", "additionalProperties": false, "required": ["captured_at", "lines"], "properties": { "captured_at": { "type": "string", "format": "date-time" }, "supersedes_snapshot_id": { "type": "string", "format": "uuid" }, "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/SnapshotLineInput" } } } },
      "SnapshotLine": { "allOf": [{ "$ref": "#/components/schemas/SnapshotLineInput" }, { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "format": "uuid" }, "account_name": { "type": "string" }, "canonical_symbol": { "type": "string" }, "instrument_type": { "type": "string" }, "native_unit": { "type": "string" }, "status": { "type": "string" } } }] },
      "Snapshot": { "type": "object", "additionalProperties": false, "required": ["id", "portfolio_id", "captured_at", "created_at", "lines"], "properties": { "id": { "type": "string", "format": "uuid" }, "portfolio_id": { "type": "string", "format": "uuid" }, "captured_at": { "type": "string", "format": "date-time" }, "supersedes_snapshot_id": { "type": "string", "format": "uuid" }, "created_at": { "type": "string", "format": "date-time" }, "lines": { "type": "array", "items": { "$ref": "#/components/schemas/SnapshotLine" } } } },
      "SnapshotPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Snapshot" } } } },
      "SeriesPage": { "type": "object", "required": ["items", "limit", "has_more"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Series" } }, "limit": { "type": "integer" }, "next_cursor": { "type": "string" }, "has_more": { "type": "boolean" } } },
      "ObservationPage": { "type": "object", "required": ["items", "limit", "has_more"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Observation" } }, "limit": { "type": "integer" }, "next_cursor": { "type": "string" }, "has_more": { "type": "boolean" } } }
    },
    "parameters": {
      "SeriesId": { "name": "series_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "InstrumentId": { "name": "instrument_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "PortfolioId": { "name": "portfolio_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "AccountId": { "name": "account_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "SnapshotId": { "name": "snapshot_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "ObservationMode": { "name": "mode", "in": "query", "required": false, "description": "Clock used for a per-series observation query.", "schema": { "type": "string", "enum": ["latest", "source-as-of", "system-as-of"], "default": "latest" } },
      "Mode": { "name": "mode", "in": "query", "required": false, "description": "Clock used for the cross-source timeline; combined is an alias for latest across the selected series.", "schema": { "type": "string", "enum": ["latest", "source-as-of", "system-as-of", "combined"], "default": "latest" } },
      "From": { "name": "from", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
      "To": { "name": "to", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
      "AsOf": { "name": "as_of", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
      "Cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1 } },
      "RequestId": {
        "name": "X-Request-ID", "in": "header", "required": false,
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": "Client-supplied correlation identifier; the server returns one when absent."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key", "in": "header", "required": false,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": "Stable key for retry-safe mutating requests."
      }
    },
    "responses": {
      "InvalidRequest": { "description": "Invalid series identifier, mode, limit, cursor, or time window", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "NotFound": { "description": "Resource not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Conflict": { "description": "Resource conflicts with an existing identifier or immutable reference", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "SourceAsOfUnsupported": { "description": "The source has no defensible source-vintage clock", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "headers": {
      "RequestId": {
        "description": "Correlation identifier for this response and its logs.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
