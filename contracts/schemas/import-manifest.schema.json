{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasrisk.local/contracts/import-manifest.schema.json",
  "title": "Versioned import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_name", "content_sha256", "object_key", "columns", "row_count"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_name": { "type": "string", "minLength": 1 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "object_key": { "type": "string", "minLength": 1 },
    "columns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "data_type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "data_type": { "enum": ["string", "decimal", "date", "datetime"] }
        }
      }
    },
    "row_count": { "type": "integer", "minimum": 0 }
  }
}
