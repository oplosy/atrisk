{
  "name": "atlasrisk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "24.16.0",
    "npm": "12.0.1"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b apps/web/tsconfig.app.json && vite build --config apps/web/vite.config.ts",
    "diagnostics": "node --version && npm --version && vite --version && tsc --version",
    "format": "prettier --write apps/web",
    "format:check": "prettier --check apps/web",
    "lint": "eslint --config apps/web/eslint.config.mjs apps/web/src apps/web/vite.config.ts",
    "test": "vitest --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
